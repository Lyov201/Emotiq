// JavaScript output can be imported by native Node.js ESM without a build step.
generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
  MISSED

  @@map("booking_status")
}

enum SessionStatus {
  PENDING
  ACTIVE
  COMPLETED
  EXPIRED

  @@map("session_status")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM

  @@map("message_role")
}

model User {
  id             String         @id @default(uuid()) @db.Uuid
  name           String
  email          String         @unique
  passwordHash   String         @map("password_hash")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  bookings       Booking[]
  sessions       Session[]
  moodEntries    MoodEntry[]
  journalEntries JournalEntry[]
  refreshTokens  RefreshToken[]

  @@map("users")
}

model Booking {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  startTime DateTime      @map("start_time") @db.Timestamptz(3)
  endTime   DateTime      @map("end_time") @db.Timestamptz(3)
  status    BookingStatus @default(SCHEDULED)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  session   Session?

  @@index([userId, startTime])
  @@index([status, startTime])
  @@map("bookings")
}

model Session {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  bookingId String        @unique @map("booking_id") @db.Uuid
  startedAt DateTime?     @map("started_at") @db.Timestamptz(3)
  endedAt   DateTime?     @map("ended_at") @db.Timestamptz(3)
  status    SessionStatus @default(PENDING)
  summary   String?       @db.Text
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  messages  Message[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("sessions")
}

model Message {
  id        String      @id @default(uuid()) @db.Uuid
  sessionId String      @map("session_id") @db.Uuid
  role      MessageRole
  content   String      @db.Text
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  session   Session     @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([sessionId, createdAt])
  @@map("messages")
}

model MoodEntry {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  moodScore Int      @map("mood_score")
  note      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, createdAt])
  @@map("mood_entries")
}

model JournalEntry {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, createdAt])
  @@map("journal_entries")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
