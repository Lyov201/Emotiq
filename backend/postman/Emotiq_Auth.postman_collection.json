            ]
          }
        }
      ]
    },
    {
      "name": "08 Missing Authorization",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/me",
        "auth": {
          "type": "noauth"
        }
      },
