      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/me",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "invalid-access-token",
              "type": "string"
            }
          ]
