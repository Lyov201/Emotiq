# Backend HTTP port and runtime environment.
PORT=4000
NODE_ENV=development

# Neon pooled URL for application queries; replace all placeholders.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require

# Same Neon database, direct hostname for Prisma migrations.
DIRECT_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require

# Generate a secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_strong_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=emotiq-api
JWT_AUDIENCE=emotiq-client
REFRESH_TOKEN_EXPIRES_DAYS=7
FRONTEND_URL=http://localhost:5173
